{
  "$schema": "https://t3.codes/schema/t3.json",
  "defaultThreadEnvMode": "worktree",
  "scripts": [
    {
      "name": "Install dependencies",
      "command": "bun install && (cd frontend && bun install)",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Lint backend",
      "command": "bun run lint",
      "icon": "lint"
    },
    {
      "name": "Build frontend",
      "command": "bun run build",
      "icon": "build"
    }
  ]
}
